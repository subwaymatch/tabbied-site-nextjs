{
  "name": "tabbied-nextjs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace tabbied && npm run llms && npm run build:images",
    "dev": "next dev",
    "prebuild": "npm run build --workspace tabbied && npm run llms && npm run build:images",
    "build": "next build && npm run templates -- --out-dir public/downloads && next build",
    "llms": "node scripts/generate-llms.mjs",
    "templates": "node scripts/package-templates.mjs",
    "build:images": "node scripts/build-image-manifest.mjs",
    "start": "serve out -l 3000 --no-clipboard",
    "test:e2e": "playwright test",
    "images:extract": "node scripts/images/extract-prompts.mjs",
    "images:build": "node scripts/images/build-batch.mjs",
    "images:submit": "node scripts/images/submit-batch.mjs",
    "images:import": "node scripts/images/import-batch.mjs",
    "images:index": "node scripts/images/index-images.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "css-doodle": "^0.51.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tabbied": "*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "serve": "^14.2.6",
    "sharp": "^0.35.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
