{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabbied",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",

  // The site is a pure static export, so `assets` is doing nearly all the work
  // here: every page, image, preview, and template zip in out/ is served
  // straight from Cloudflare's network without invoking the Worker at all.
  //
  // `npm run build` must have run first — out/ is not in git. It is two
  // `next build` passes with the template packager between them; see the
  // "Downloadable templates" section of CLAUDE.md for why that shape is forced.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // Serve out/404.html for anything that matches no asset. Unlike Pages,
    // Workers does not infer this from the presence of a 404.html.
    "not_found_handling": "404-page",

    // Only the Worker's own routes jump the queue. /mcp is not a file, so it
    // would reach the Worker anyway — but only after the asset router had a
    // look at it, and with `trailingSlash: true` in next.config.mjs the
    // default html_handling would answer a POST to /mcp with a 308 to /mcp/.
    // Redirecting an MCP client's POST breaks it, so the Worker takes the path
    // before any of that can happen.
    //
    // /api is here for exactly the same reason and it is not optional: every
    // POST to the platform tier (sign-in, projects, AI tasks) would otherwise
    // be answered with a redirect before the Worker ever saw it. Any new
    // non-asset route must join this list.
    "run_worker_first": ["/mcp", "/mcp/*", "/health", "/api", "/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // ---- the platform tier -------------------------------------------------
  // Identity, generations and media. All three are simulated locally by
  // `wrangler dev` / the vitest pool, so the whole stack runs and is tested
  // without provisioning anything; the ids below are the only thing a real
  // deploy needs filled in.
  //
  //   wrangler d1 create tabbied      → paste database_id
  //   wrangler kv namespace create SESSIONS → paste id
  //   wrangler r2 bucket create tabbied-media
  //
  // Then apply migrations before the first deploy that uses them:
  //   wrangler d1 migrations apply tabbied --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabbied",
      // PLACEHOLDER: local dev and tests ignore this; `wrangler deploy` does not.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],

  // Session lookups are a KV read rather than a D1 query (better-auth's
  // secondaryStorage), and the rate-limit counters live here too — both are
  // hot, tiny, and expendable, which is exactly what KV is for.
  "kv_namespaces": [
    {
      "binding": "KV",
      // PLACEHOLDER, as above.
      "id": "0000000000000000000000000000000f"
    }
  ],

  // Generated images (gen/<generationId>/) and user uploads (up/<userId>/).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tabbied-media"
    }
  ],

  "vars": {
    // The public origin the auth cookies and OAuth callbacks are issued for.
    // Overridden per environment; the workers.dev host until the zone moves.
    "PUBLIC_ORIGIN": "https://tabbied.com",
    // An OpenAI-compatible base. Cloudflare AI Gateway in front of it is a
    // change to this value and nothing else.
    "AI_BASE_URL": "https://api.openai.com/v1",
    "AI_MODEL": "gpt-5",
    // gpt-image-2 emits real alpha (background: "transparent"), which is why
    // there is no second vendor here; see docs/image-pipeline.md.
    "AI_IMAGE_MODEL": "gpt-image-2"
  }

  // Secrets (never in this file): AI_API_KEY, BETTER_AUTH_SECRET, RESEND_API_KEY,
  // TURNSTILE_SECRET_KEY, GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET.
  // Locally they live in .dev.vars (gitignored); in production,
  // `wrangler secret put <NAME>`.

  // Custom domain, deliberately not declared here yet. Until tabbied.com is a
  // zone in this Cloudflare account, a `routes` entry makes `wrangler deploy`
  // fail outright rather than fall back — so the first deploys land on
  // tabbied.<subdomain>.workers.dev and the domain is attached afterwards
  // (Workers → tabbied → Settings → Domains & Routes → Add custom domain,
  // which creates the DNS record for you). Once the zone is here, this becomes
  // the reproducible form and can be uncommented:
  //
  // "routes": [
  //   { "pattern": "tabbied.com", "custom_domain": true },
  //   { "pattern": "www.tabbied.com", "custom_domain": true }
  // ]
}
