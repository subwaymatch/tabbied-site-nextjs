{
  "compilerOptions": {
    "target": "ES2022",
    // DOM supplies Request/Response for the Streamable HTTP binding, which runs
    // on the Web platform (Cloudflare Workers) rather than on node's http.
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
