{
  "name": "tabbied",
  "version": "0.4.0",
  "description": "Tabbied generative patterns: a framework-agnostic core plus a React component, powered by css-doodle.",
  "type": "module",
  "license": "MIT",
  "author": "Sy Hong and Ye Joo Park",
  "homepage": "https://tabbied.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/subwaymatch/tabbied.git",
    "directory": "packages/tabbied"
  },
  "keywords": [
    "css-doodle",
    "generative",
    "generative-art",
    "art",
    "pattern",
    "svg",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns.generated.d.ts",
      "import": "./dist/patterns.generated.js",
      "default": "./dist/patterns.generated.js"
    },
    "./svg-export": {
      "types": "./dist/core/svgExport.d.ts",
      "import": "./dist/core/svgExport.js",
      "default": "./dist/core/svgExport.js"
    },
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "tabbied": "./dist/cli.js"
  },
  "files": [
    "dist",
    "catalog.json",
    "llms.txt",
    "AGENTS.md"
  ],
  "sideEffects": [
    "./dist/**/register.js"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "node scripts/codegen.mjs && node scripts/generate-llms.mjs && node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test",
    "dev": "node scripts/codegen.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "node scripts/codegen.mjs && tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "css-doodle": "^0.51.0"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
