{
  "name": "Cresting",
  "slug": "cresting",
  "galleryOrder": 2044,
  "galleryWhite": true,
  "description": "A run of points standing along the ridge line.",
  "palette": [
    "#181818",
    "#EC4E20",
    "#FF9505",
    "#016FB9",
    "#FFFFFF",
    "#C2E7DA"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 90deg, 180deg, 270deg); @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 62.0%, 0.0% 42.0%, 16.0% 20.0%, 32.0% 42.0%, 48.0% 20.0%, 64.0% 42.0%, 80.0% 20.0%, 96.0% 42.0%, 100.0% 42.0%, 100.0% 62.0%); clip-path: polygon(0.0% 62.0%, 0.0% 42.0%, 16.0% 20.0%, 32.0% 42.0%, 48.0% 20.0%, 64.0% 42.0%, 80.0% 20.0%, 96.0% 42.0%, 100.0% 42.0%, 100.0% 62.0%); -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
