{
  "name": "Mortise",
  "slug": "mortise",
  "galleryOrder": 631,
  "description": "A mortise cut square through each block, standing upright in one column and lying flat in the next.",
  "tags": [
    "blocks",
    "squares",
    "grid"
  ],
  "mood": [
    "bold",
    "playful",
    "festive"
  ],
  "density": "dense",
  "goodFor": [
    "poster",
    "og-image",
    "textile"
  ],
  "palette": [
    "#FDF6E3",
    "#073642",
    "#268BD2",
    "#D33682",
    "#859900",
    "#CB4B16"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 34.0% 18.0%, 34.0% 82.0%, 66.0% 82.0%, 66.0% 18.0%, 34.0% 18.0%); clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 34.0% 18.0%, 34.0% 82.0%, 66.0% 82.0%, 66.0% 18.0%, 34.0% 18.0%); @match(@x % 2 == 1) { -webkit-clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 18.0% 34.0%, 18.0% 66.0%, 82.0% 66.0%, 82.0% 34.0%, 18.0% 34.0%); clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 18.0% 34.0%, 18.0% 66.0%, 82.0% 66.0%, 82.0% 34.0%, 18.0% 34.0%); } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
