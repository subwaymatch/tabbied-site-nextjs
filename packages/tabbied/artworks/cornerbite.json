{
  "name": "Cornerbite",
  "slug": "cornerbite",
  "galleryOrder": 701,
  "description": "Full squares with a quarter-circle bitten out of one corner — a deep bite on most, a shallow nick on the rest, the corner rolling a quarter turn at a time.",
  "palette": [
    "#F7F7FF",
    "#2D3142",
    "#4F5D75",
    "#BFC0C0",
    "#EF8354",
    "#3D5A80"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 90deg, 180deg, 270deg); @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 66.0%, 0.0% 66.0%, 7.4% 65.6%, 14.7% 64.3%, 21.8% 62.3%, 28.6% 59.5%, 35.1% 55.9%, 41.2% 51.6%, 46.7% 46.7%, 51.6% 41.2%, 55.9% 35.1%, 59.5% 28.6%, 62.3% 21.8%, 64.3% 14.7%, 65.6% 7.4%, 66.0% 0.0%); clip-path: polygon(100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 66.0%, 0.0% 66.0%, 7.4% 65.6%, 14.7% 64.3%, 21.8% 62.3%, 28.6% 59.5%, 35.1% 55.9%, 41.2% 51.6%, 46.7% 46.7%, 51.6% 41.2%, 55.9% 35.1%, 59.5% 28.6%, 62.3% 21.8%, 64.3% 14.7%, 65.6% 7.4%, 66.0% 0.0%); -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); @random(0.35) { -webkit-clip-path: polygon(100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 30.0%, 0.0% 30.0%, 3.4% 29.8%, 6.7% 29.2%, 9.9% 28.3%, 13.0% 27.0%, 16.0% 25.4%, 18.7% 23.5%, 21.2% 21.2%, 23.5% 18.7%, 25.4% 16.0%, 27.0% 13.0%, 28.3% 9.9%, 29.2% 6.7%, 29.8% 3.4%, 30.0% 0.0%); clip-path: polygon(100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 30.0%, 0.0% 30.0%, 3.4% 29.8%, 6.7% 29.2%, 9.9% 28.3%, 13.0% 27.0%, 16.0% 25.4%, 18.7% 23.5%, 21.2% 21.2%, 23.5% 18.7%, 25.4% 16.0%, 27.0% 13.0%, 28.3% 9.9%, 29.2% 6.7%, 29.8% 3.4%, 30.0% 0.0%); } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
