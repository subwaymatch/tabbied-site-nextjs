{
  "name": "Stampform",
  "slug": "stampform",
  "galleryOrder": 1564,
  "description": "A block with a row of square perforations bitten out of one edge.",
  "palette": [
    "#F0EAD6",
    "#264653",
    "#2A9D8F",
    "#E9C46A",
    "#F4A261",
    "#E76F51"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 90deg, 180deg, 270deg); @random(${shapeFrequency}) { :after { content: ''; position: absolute; inset: 12%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 6.0%, 6.2% 6.0%, 6.2% 0.0%, 12.5% 0.0%, 12.5% 6.0%, 18.8% 6.0%, 18.8% 0.0%, 25.0% 0.0%, 25.0% 6.0%, 31.2% 6.0%, 31.2% 0.0%, 37.5% 0.0%, 37.5% 6.0%, 43.8% 6.0%, 43.8% 0.0%, 50.0% 0.0%, 50.0% 6.0%, 56.2% 6.0%, 56.2% 0.0%, 62.5% 0.0%, 62.5% 6.0%, 68.8% 6.0%, 68.8% 0.0%, 75.0% 0.0%, 75.0% 6.0%, 81.2% 6.0%, 81.2% 0.0%, 87.5% 0.0%, 87.5% 6.0%, 93.8% 6.0%, 93.8% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%); clip-path: polygon(0.0% 6.0%, 6.2% 6.0%, 6.2% 0.0%, 12.5% 0.0%, 12.5% 6.0%, 18.8% 6.0%, 18.8% 0.0%, 25.0% 0.0%, 25.0% 6.0%, 31.2% 6.0%, 31.2% 0.0%, 37.5% 0.0%, 37.5% 6.0%, 43.8% 6.0%, 43.8% 0.0%, 50.0% 0.0%, 50.0% 6.0%, 56.2% 6.0%, 56.2% 0.0%, 62.5% 0.0%, 62.5% 6.0%, 68.8% 6.0%, 68.8% 0.0%, 75.0% 0.0%, 75.0% 6.0%, 81.2% 6.0%, 81.2% 0.0%, 87.5% 0.0%, 87.5% 6.0%, 93.8% 6.0%, 93.8% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%); -webkit-transition: ease 450ms; transition: ease 450ms; } -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
