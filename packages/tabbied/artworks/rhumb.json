{
  "name": "Rhumb",
  "slug": "rhumb",
  "galleryOrder": 839,
  "description": "A wind rose: lines of constant bearing radiating from a single node.",
  "palette": [
    "#F0EAD6",
    "#264653",
    "#2A9D8F",
    "#E9C46A",
    "#F4A261",
    "#E76F51"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { :before { content: ''; position: absolute; inset: 0; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(45.5% 0.0%, 54.5% 0.0%, 54.5% 45.5%, 100.0% 45.5%, 100.0% 54.5%, 54.5% 54.5%, 54.5% 100.0%, 45.5% 100.0%, 45.5% 54.5%, 0.0% 54.5%, 0.0% 45.5%, 45.5% 45.5%); clip-path: polygon(45.5% 0.0%, 54.5% 0.0%, 54.5% 45.5%, 100.0% 45.5%, 100.0% 54.5%, 54.5% 54.5%, 54.5% 100.0%, 45.5% 100.0%, 45.5% 54.5%, 0.0% 54.5%, 0.0% 45.5%, 45.5% 45.5%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 0; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(45.5% 0.0%, 54.5% 0.0%, 54.5% 45.5%, 100.0% 45.5%, 100.0% 54.5%, 54.5% 54.5%, 54.5% 100.0%, 45.5% 100.0%, 45.5% 54.5%, 0.0% 54.5%, 0.0% 45.5%, 45.5% 45.5%); clip-path: polygon(45.5% 0.0%, 54.5% 0.0%, 54.5% 45.5%, 100.0% 45.5%, 100.0% 54.5%, 54.5% 54.5%, 54.5% 100.0%, 45.5% 100.0%, 45.5% 54.5%, 0.0% 54.5%, 0.0% 45.5%, 45.5% 45.5%); -webkit-transform: rotate(45deg); transform: rotate(45deg); -webkit-transition: ease 450ms; transition: ease 450ms; } -webkit-transform: rotate(@pick(0deg, 22deg)); transform: rotate(@pick(0deg, 22deg)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
