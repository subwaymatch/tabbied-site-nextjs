{
  "name": "Girih",
  "slug": "girih",
  "galleryOrder": 884,
  "galleryWhite": true,
  "description": "Girih strapwork: a ten-pointed rosette with the strap left open where it passes under.",
  "palette": [
    "#231942",
    "#5E548E",
    "#9F86C0",
    "#BE95C4",
    "#E0B1CB",
    "#F7ECFF"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { :before { content: ''; position: absolute; inset: 2%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(50.0% 0.0%, 58.7% 23.4%, 79.4% 9.5%, 72.7% 33.5%, 97.6% 34.5%, 78.0% 50.0%, 97.6% 65.5%, 72.7% 66.5%, 79.4% 90.5%, 58.7% 76.6%, 50.0% 100.0%, 41.3% 76.6%, 20.6% 90.5%, 27.3% 66.5%, 2.4% 65.5%, 22.0% 50.0%, 2.4% 34.5%, 27.3% 33.5%, 20.6% 9.5%, 41.3% 23.4%); clip-path: polygon(50.0% 0.0%, 58.7% 23.4%, 79.4% 9.5%, 72.7% 33.5%, 97.6% 34.5%, 78.0% 50.0%, 97.6% 65.5%, 72.7% 66.5%, 79.4% 90.5%, 58.7% 76.6%, 50.0% 100.0%, 41.3% 76.6%, 20.6% 90.5%, 27.3% 66.5%, 2.4% 65.5%, 22.0% 50.0%, 2.4% 34.5%, 27.3% 33.5%, 20.6% 9.5%, 41.3% 23.4%); -webkit-mask: radial-gradient(circle closest-side at 50% 50%, transparent 62%, #000 62%); mask: radial-gradient(circle closest-side at 50% 50%, transparent 62%, #000 62%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 34%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(50.0% 0.0%, 79.4% 9.5%, 97.6% 34.5%, 97.6% 65.5%, 79.4% 90.5%, 50.0% 100.0%, 20.6% 90.5%, 2.4% 65.5%, 2.4% 34.5%, 20.6% 9.5%); clip-path: polygon(50.0% 0.0%, 79.4% 9.5%, 97.6% 34.5%, 97.6% 65.5%, 79.4% 90.5%, 50.0% 100.0%, 20.6% 90.5%, 2.4% 65.5%, 2.4% 34.5%, 20.6% 9.5%); -webkit-mask: radial-gradient(circle closest-side at 50% 50%, transparent 58%, #000 58%); mask: radial-gradient(circle closest-side at 50% 50%, transparent 58%, #000 58%); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
