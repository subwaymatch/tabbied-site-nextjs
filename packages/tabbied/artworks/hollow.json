{
  "name": "Hollow",
  "slug": "hollow",
  "galleryOrder": 1203,
  "galleryWhite": true,
  "description": "Hollowed out: a thick wall with nothing inside it.",
  "palette": [
    "#101820",
    "#FEE715",
    "#F2F2F2",
    "#8A8D91",
    "#00A6A6",
    "#FF6B35"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 0.0%, 84.0% 50.0%, 83.1% 42.4%, 80.6% 35.2%, 76.6% 28.8%, 71.2% 23.4%, 64.8% 19.4%, 57.6% 16.9%, 50.0% 16.0%, 42.4% 16.9%, 35.2% 19.4%, 28.8% 23.4%, 23.4% 28.8%, 19.4% 35.2%, 16.9% 42.4%, 16.0% 50.0%, 16.9% 57.6%, 19.4% 64.8%, 23.4% 71.2%, 28.8% 76.6%, 35.2% 80.6%, 42.4% 83.1%, 50.0% 84.0%, 57.6% 83.1%, 64.8% 80.6%, 71.2% 76.6%, 76.6% 71.2%, 80.6% 64.8%, 83.1% 57.6%, 84.0% 50.0%); clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 0.0%, 84.0% 50.0%, 83.1% 42.4%, 80.6% 35.2%, 76.6% 28.8%, 71.2% 23.4%, 64.8% 19.4%, 57.6% 16.9%, 50.0% 16.0%, 42.4% 16.9%, 35.2% 19.4%, 28.8% 23.4%, 23.4% 28.8%, 19.4% 35.2%, 16.9% 42.4%, 16.0% 50.0%, 16.9% 57.6%, 19.4% 64.8%, 23.4% 71.2%, 28.8% 76.6%, 35.2% 80.6%, 42.4% 83.1%, 50.0% 84.0%, 57.6% 83.1%, 64.8% 80.6%, 71.2% 76.6%, 76.6% 71.2%, 80.6% 64.8%, 83.1% 57.6%, 84.0% 50.0%); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
