{
  "name": "Voronoi",
  "slug": "voronoi",
  "galleryOrder": 1044,
  "description": "Cells growing from a seed that sits at a different corner in each one, so the boundaries never line up.",
  "palette": [
    "#F0EAD6",
    "#264653",
    "#2A9D8F",
    "#E9C46A",
    "#F4A261",
    "#E76F51"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: @pick(polygon(0 0, 100% 0, 72% 100%, 0 68%), polygon(0 0, 100% 0, 100% 74%, 26% 100%), polygon(28% 0, 100% 0, 100% 100%, 0 100%, 0 22%), polygon(0 0, 76% 0, 100% 30%, 100% 100%, 0 100%)); clip-path: @pick(polygon(0 0, 100% 0, 72% 100%, 0 68%), polygon(0 0, 100% 0, 100% 74%, 26% 100%), polygon(28% 0, 100% 0, 100% 100%, 0 100%, 0 22%), polygon(0 0, 76% 0, 100% 30%, 100% 100%, 0 100%)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
