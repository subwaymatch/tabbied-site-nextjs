{
  "name": "Papercut",
  "slug": "papercut",
  "galleryOrder": 882,
  "galleryWhite": true,
  "description": "Papercutting: the design is the hole, so every shape here is genuinely absent.",
  "palette": [
    "#0B2540",
    "#1B4075",
    "#3E8BFF",
    "#3EECFF",
    "#9EFFD8",
    "#ECFFEC"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: @pick(polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 80.0% 50.0%, 79.2% 43.3%, 77.0% 37.0%, 73.5% 31.3%, 68.7% 26.5%, 63.0% 23.0%, 56.7% 20.8%, 50.0% 20.0%, 43.3% 20.8%, 37.0% 23.0%, 31.3% 26.5%, 26.5% 31.3%, 23.0% 37.0%, 20.8% 43.3%, 20.0% 50.0%, 20.8% 56.7%, 23.0% 63.0%, 26.5% 68.7%, 31.3% 73.5%, 37.0% 77.0%, 43.3% 79.2%, 50.0% 80.0%, 56.7% 79.2%, 63.0% 77.0%, 68.7% 73.5%, 73.5% 68.7%, 77.0% 63.0%, 79.2% 56.7%, 80.0% 50.0%), polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 50.0% 12.0%, 12.0% 50.0%, 50.0% 88.0%, 88.0% 50.0%, 50.0% 12.0%), polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 28.0% 28.0%, 28.0% 72.0%, 72.0% 72.0%, 72.0% 28.0%, 28.0% 28.0%)); clip-path: @pick(polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 80.0% 50.0%, 79.2% 43.3%, 77.0% 37.0%, 73.5% 31.3%, 68.7% 26.5%, 63.0% 23.0%, 56.7% 20.8%, 50.0% 20.0%, 43.3% 20.8%, 37.0% 23.0%, 31.3% 26.5%, 26.5% 31.3%, 23.0% 37.0%, 20.8% 43.3%, 20.0% 50.0%, 20.8% 56.7%, 23.0% 63.0%, 26.5% 68.7%, 31.3% 73.5%, 37.0% 77.0%, 43.3% 79.2%, 50.0% 80.0%, 56.7% 79.2%, 63.0% 77.0%, 68.7% 73.5%, 73.5% 68.7%, 77.0% 63.0%, 79.2% 56.7%, 80.0% 50.0%), polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 50.0% 12.0%, 12.0% 50.0%, 50.0% 88.0%, 88.0% 50.0%, 50.0% 12.0%), polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 28.0% 28.0%, 28.0% 72.0%, 72.0% 72.0%, 72.0% 28.0%, 28.0% 28.0%)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
