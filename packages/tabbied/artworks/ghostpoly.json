{
  "name": "Ghostpoly",
  "slug": "ghostpoly",
  "galleryOrder": 1459,
  "galleryWhite": true,
  "description": "A sixteen-sided profile, present only where the ramp has not taken it.",
  "palette": [
    "#221E22",
    "#EFD9CE",
    "#DEC0F1",
    "#B79CED",
    "#957FEF",
    "#7161EF"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 90deg); @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(50.0% 2.0%, 72.0% 14.0%, 86.0% 14.0%, 86.0% 28.0%, 98.0% 50.0%, 86.0% 72.0%, 86.0% 86.0%, 72.0% 86.0%, 50.0% 98.0%, 28.0% 86.0%, 14.0% 86.0%, 14.0% 72.0%, 2.0% 50.0%, 14.0% 28.0%, 14.0% 14.0%, 28.0% 14.0%); clip-path: polygon(50.0% 2.0%, 72.0% 14.0%, 86.0% 14.0%, 86.0% 28.0%, 98.0% 50.0%, 86.0% 72.0%, 86.0% 86.0%, 72.0% 86.0%, 50.0% 98.0%, 28.0% 86.0%, 14.0% 86.0%, 14.0% 72.0%, 2.0% 50.0%, 14.0% 28.0%, 14.0% 14.0%, 28.0% 14.0%); -webkit-mask: radial-gradient(circle closest-side at 50% 50%, #000 0%, transparent 100%); mask: radial-gradient(circle closest-side at 50% 50%, #000 0%, transparent 100%); -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
