{
  "name": "Sepal",
  "slug": "sepal",
  "galleryOrder": 855,
  "galleryWhite": true,
  "description": "A single sepal — a pointed leaf with one vein down the middle.",
  "palette": [
    "#0F2A1E",
    "#2F6B3C",
    "#4F9D5D",
    "#8CC084",
    "#C8E6C0",
    "#ECFFEC"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 45deg, 90deg, 135deg, 180deg, 225deg, 270deg, 315deg); @random(${shapeFrequency}) { :before { content: ''; position: absolute; inset: 4%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(50.0% 0.0%, 56.3% 0.8%, 62.3% 3.0%, 68.0% 6.7%, 73.1% 11.7%, 77.6% 17.9%, 81.2% 25.0%, 83.8% 32.9%, 85.5% 41.3%, 86.0% 50.0%, 85.5% 58.7%, 83.8% 67.1%, 81.2% 75.0%, 77.6% 82.1%, 73.1% 88.3%, 68.0% 93.3%, 62.3% 97.0%, 56.3% 99.2%, 50.0% 100.0%, 50.0% 100.0%, 43.7% 99.2%, 37.7% 97.0%, 32.0% 93.3%, 26.9% 88.3%, 22.4% 82.1%, 18.8% 75.0%, 16.2% 67.1%, 14.5% 58.7%, 14.0% 50.0%, 14.5% 41.3%, 16.2% 32.9%, 18.8% 25.0%, 22.4% 17.9%, 26.9% 11.7%, 32.0% 6.7%, 37.7% 3.0%, 43.7% 0.8%, 50.0% 0.0%); clip-path: polygon(50.0% 0.0%, 56.3% 0.8%, 62.3% 3.0%, 68.0% 6.7%, 73.1% 11.7%, 77.6% 17.9%, 81.2% 25.0%, 83.8% 32.9%, 85.5% 41.3%, 86.0% 50.0%, 85.5% 58.7%, 83.8% 67.1%, 81.2% 75.0%, 77.6% 82.1%, 73.1% 88.3%, 68.0% 93.3%, 62.3% 97.0%, 56.3% 99.2%, 50.0% 100.0%, 50.0% 100.0%, 43.7% 99.2%, 37.7% 97.0%, 32.0% 93.3%, 26.9% 88.3%, 22.4% 82.1%, 18.8% 75.0%, 16.2% 67.1%, 14.5% 58.7%, 14.0% 50.0%, 14.5% 41.3%, 16.2% 32.9%, 18.8% 25.0%, 22.4% 17.9%, 26.9% 11.7%, 32.0% 6.7%, 37.7% 3.0%, 43.7% 0.8%, 50.0% 0.0%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; left: 47%; top: 12%; width: 6%; height: 76%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-transition: ease 450ms; transition: ease 450ms; } -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
