{
  "name": "Corona",
  "slug": "corona",
  "galleryOrder": 830,
  "description": "The crown seen only at totality: spikes standing off a dark disc.",
  "palette": [
    "#FFF9F5",
    "#FF8FB8",
    "#FFC2D4",
    "#FF8A5C",
    "#D89FFF",
    "#F5C542"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { :before { content: ''; position: absolute; inset: 0; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(50.0% 0.0%, 56.5% 25.9%, 75.0% 6.7%, 67.7% 32.3%, 93.3% 25.0%, 74.1% 43.5%, 100.0% 50.0%, 74.1% 56.5%, 93.3% 75.0%, 67.7% 67.7%, 75.0% 93.3%, 56.5% 74.1%, 50.0% 100.0%, 43.5% 74.1%, 25.0% 93.3%, 32.3% 67.7%, 6.7% 75.0%, 25.9% 56.5%, 0.0% 50.0%, 25.9% 43.5%, 6.7% 25.0%, 32.3% 32.3%, 25.0% 6.7%, 43.5% 25.9%); clip-path: polygon(50.0% 0.0%, 56.5% 25.9%, 75.0% 6.7%, 67.7% 32.3%, 93.3% 25.0%, 74.1% 43.5%, 100.0% 50.0%, 74.1% 56.5%, 93.3% 75.0%, 67.7% 67.7%, 75.0% 93.3%, 56.5% 74.1%, 50.0% 100.0%, 43.5% 74.1%, 25.0% 93.3%, 32.3% 67.7%, 6.7% 75.0%, 25.9% 56.5%, 0.0% 50.0%, 25.9% 43.5%, 6.7% 25.0%, 32.3% 32.3%, 25.0% 6.7%, 43.5% 25.9%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 30%; border-radius: 50%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-transition: ease 450ms; transition: ease 450ms; } -webkit-transform: rotate(@pick(0deg, 45deg, 90deg, 135deg, 180deg, 225deg, 270deg, 315deg)); transform: rotate(@pick(0deg, 45deg, 90deg, 135deg, 180deg, 225deg, 270deg, 315deg)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
