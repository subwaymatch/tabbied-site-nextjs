{
  "name": "Recess",
  "slug": "recess",
  "galleryOrder": 1205,
  "galleryWhite": true,
  "description": "A recess with a square shoulder: two steps down into the block.",
  "palette": [
    "#11151A",
    "#FF5252",
    "#FFB300",
    "#26C6DA",
    "#66BB6A",
    "#EEEEEE"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { :before { content: ''; position: absolute; inset: 0; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 0.0%, 20.0% 20.0%, 20.0% 80.0%, 80.0% 80.0%, 80.0% 20.0%, 20.0% 20.0%); clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 0.0%, 20.0% 20.0%, 20.0% 80.0%, 80.0% 80.0%, 80.0% 20.0%, 20.0% 20.0%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 20%; background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 0.0%, 24.0% 24.0%, 24.0% 76.0%, 76.0% 76.0%, 76.0% 24.0%, 24.0% 24.0%); clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 0.0% 100.0%, 0.0% 0.0%, 24.0% 24.0%, 24.0% 76.0%, 76.0% 76.0%, 76.0% 24.0%, 24.0% 24.0%); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
