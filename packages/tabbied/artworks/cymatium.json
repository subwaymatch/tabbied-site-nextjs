{
  "name": "Cymatium",
  "slug": "cymatium",
  "galleryOrder": 1320,
  "description": "A moulding drawn as a run of short straight facets: an S profile without any curve in it.",
  "palette": [
    "#FFF0F3",
    "#590D22",
    "#A4133C",
    "#C9184A",
    "#FF758F",
    "#FFB3C1"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 90deg, 180deg, 270deg); @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 72.0% 100.0%, 72.0% 82.0%, 56.0% 74.0%, 44.0% 60.0%, 40.0% 42.0%, 28.0% 30.0%, 0.0% 24.0%); clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 100.0%, 72.0% 100.0%, 72.0% 82.0%, 56.0% 74.0%, 44.0% 60.0%, 40.0% 42.0%, 28.0% 30.0%, 0.0% 24.0%); -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
