{
  "name": "Guttae",
  "slug": "guttae",
  "galleryOrder": 1317,
  "description": "A row of small square teeth left standing along one edge.",
  "palette": [
    "#F5F5F0",
    "#161616",
    "#5A5A5A",
    "#9A9A9A",
    "#3A3A3A",
    "#C8C8C8"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --rot: @pick(0deg, 90deg, 180deg, 270deg); @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 66.0%, 86.0% 66.0%, 86.0% 100.0%, 72.0% 100.0%, 72.0% 66.0%, 58.0% 66.0%, 58.0% 100.0%, 44.0% 100.0%, 44.0% 66.0%, 30.0% 66.0%, 30.0% 100.0%, 16.0% 100.0%, 16.0% 66.0%, 0.0% 66.0%); clip-path: polygon(0.0% 0.0%, 100.0% 0.0%, 100.0% 66.0%, 86.0% 66.0%, 86.0% 100.0%, 72.0% 100.0%, 72.0% 66.0%, 58.0% 66.0%, 58.0% 100.0%, 44.0% 100.0%, 44.0% 66.0%, 30.0% 66.0%, 30.0% 100.0%, 16.0% 100.0%, 16.0% 66.0%, 0.0% 66.0%); -webkit-transform: rotate(@var(--rot)); transform: rotate(@var(--rot)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box } :container { background: var(--color0); overflow:hidden; }"
  }
}
