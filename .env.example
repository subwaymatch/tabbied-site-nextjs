# Copy to .env.local (git-ignored) and fill in.
#
#   cp .env.example .env.local
#
# Used by the template image pipeline, scripts/images/*.mjs.
# See scripts/images/README.md.

# Required. Get one at https://kie.ai/api-key
KIE_API_KEY=

# Optional. Model slug on KIE. Defaults to z-image.
# KIE_MODEL=z-image

# Optional. Requests allowed per 10 seconds. KIE's account ceiling is 20 and
# over-limit requests are rejected rather than queued, so leave headroom.
# KIE_RATE_LIMIT=18

# Optional. API root, for a proxy or a mock server.
# KIE_API_BASE=https://api.kie.ai/api/v1
